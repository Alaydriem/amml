{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMML Launcher",
  "version": "26.60.0",
  "identifier": "com.alaydriem.amml.launcher",
  "build": {
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "yarn vite dev",
    "beforeBuildCommand": "yarn vite build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AMML Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/i18n/*"]
  }
}
