  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/dom": "^10.4",
    "@testing-library/jest-dom": "^7.0",
    "@testing-library/svelte": "^5.4",
    "@testing-library/user-event": "^14.6",
    "@types/node": "^25",
    "happy-dom": "^20.11",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1"
  }
