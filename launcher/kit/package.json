{
  "name": "@amml/launcher-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Svelte 5 components and screens for the AMML launcher, built from the Paper page Launcher v1",
  "license": "BSD-3-Clause",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css/tokens.css": "./src/css/tokens.css",
    "./css/base.css": "./src/css/base.css",
    "./fixtures": {
      "types": "./src/fixtures/index.ts",
      "default": "./src/fixtures/index.ts"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
